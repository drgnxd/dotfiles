{
  "theme": "dark",
  "model": "sonnet",
  "autoMemoryEnabled": false,
  "preferredNotifChannel": "notifications_disabled",
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright-auth__browser_evaluate",
      "mcp__playwright-auth__browser_file_upload",
      "mcp__playwright-auth__browser_network_requests",
      "mcp__playwright-auth__browser_console_messages",
      "mcp__playwright-auth__browser_cookie_clear",
      "mcp__playwright-auth__browser_cookie_delete",
      "mcp__playwright-auth__browser_cookie_get",
      "mcp__playwright-auth__browser_cookie_list",
      "mcp__playwright-auth__browser_cookie_set",
      "mcp__playwright-auth__browser_localstorage_clear",
      "mcp__playwright-auth__browser_localstorage_delete",
      "mcp__playwright-auth__browser_localstorage_get",
      "mcp__playwright-auth__browser_localstorage_list",
      "mcp__playwright-auth__browser_localstorage_set",
      "mcp__playwright-auth__browser_network_request",
      "mcp__playwright-auth__browser_network_requests",
      "mcp__playwright-auth__browser_run_code_unsafe",
      "mcp__playwright-auth__browser_sessionstorage_clear",
      "mcp__playwright-auth__browser_sessionstorage_delete",
      "mcp__playwright-auth__browser_sessionstorage_get",
      "mcp__playwright-auth__browser_sessionstorage_list",
      "mcp__playwright-auth__browser_sessionstorage_set",
      "mcp__playwright-auth__browser_set_storage_state",
      "mcp__playwright__browser_network_request",
      "mcp__playwright__browser_cookie_clear",
      "mcp__playwright__browser_cookie_delete",
      "mcp__playwright__browser_cookie_get",
      "mcp__playwright__browser_cookie_list",
      "mcp__playwright__browser_cookie_set",
      "mcp__playwright__browser_localstorage_clear",
      "mcp__playwright__browser_localstorage_delete",
      "mcp__playwright__browser_localstorage_get",
      "mcp__playwright__browser_localstorage_list",
      "mcp__playwright__browser_localstorage_set",
      "mcp__playwright__browser_sessionstorage_clear",
      "mcp__playwright__browser_sessionstorage_delete",
      "mcp__playwright__browser_sessionstorage_get",
      "mcp__playwright__browser_sessionstorage_list",
      "mcp__playwright__browser_sessionstorage_set",
      "mcp__playwright__browser_set_storage_state"
    ],
    "allow": [
      "WebSearch",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(lsof *)",
      "Bash(top *)",
      "Bash(sysctl *)",
      "Bash(uname *)",
      "Bash(sw_vers)",
      "Bash(system_profiler *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(nix eval *)",
      "Bash(nix search *)",
      "Bash(nix show-config *)",
      "Bash(nix derivation *)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults"
    ]
  }
}
