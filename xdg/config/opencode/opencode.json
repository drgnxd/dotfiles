{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "default_agent": "main",
  "enabled_providers": [
    "openai"
  ],
  "share": "disabled",
  "permission": {
    "fetch_pdf": "deny",
    "research_search_*": "deny"
  },
  "subagent_depth": 1,
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000
      }
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "compaction": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "title": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "summary": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "researcher": {
      "description": "Answers one narrow question from public web sources or delegated read-only Playwright browser research. No local files, commands, edits, or delegation. Main dispatches directly for browser tasks and scoped questions within broader research.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "medium",
      "color": "#9ccc65",
      "tools": {
        "execute": true,
        "webfetch": true,
        "websearch": true,
        "fetch_pdf": true,
        "skill": true,
        "playwright_browser_session_create": true,
        "playwright_browser_session_close": true,
        "playwright_browser_navigate": true,
        "playwright_browser_navigate_back": true,
        "playwright_browser_click": true,
        "playwright_browser_press_key": true,
        "playwright_browser_fill_form": true,
        "playwright_browser_type": true,
        "playwright_browser_snapshot": true,
        "playwright_browser_find": true,
        "playwright_browser_wait_for": true,
        "playwright_browser_take_screenshot": true
      },
      "permission": {
        "*": "deny",
        "execute*": "allow",
        "webfetch*": "allow",
        "websearch*": "allow",
        "fetch_pdf*": "allow",
        "skill*": "allow",
        "playwright_browser_session_create*": "allow",
        "playwright_browser_session_close*": "allow",
        "playwright_browser_navigate*": "allow",
        "playwright_browser_navigate_back*": "allow",
        "playwright_browser_click*": "allow",
        "playwright_browser_press_key*": "allow",
        "playwright_browser_fill_form*": "allow",
        "playwright_browser_type*": "allow",
        "playwright_browser_snapshot*": "allow",
        "playwright_browser_find*": "allow",
        "playwright_browser_wait_for*": "allow",
        "playwright_browser_take_screenshot*": "allow"
      },
      "prompt": "{file:./prompts/researcher.md}"
    },
    "browser-operator": {
      "description": "Removes one exact, user-authorized list entry after the parent confirms it is represented in the destination; never purchases or edits account settings.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "medium",
      "tools": {
        "playwright_browser_session_create": true,
        "playwright_browser_session_close": true,
        "playwright_browser_navigate": true,
        "playwright_browser_navigate_back": true,
        "playwright_browser_snapshot": true,
        "playwright_browser_find": true,
        "playwright_browser_wait_for": true,
        "playwright_browser_click": true
      },
      "permission": {
        "*": "deny",
        "playwright_browser_session_create*": "allow",
        "playwright_browser_session_close*": "allow",
        "playwright_browser_navigate*": "allow",
        "playwright_browser_navigate_back*": "allow",
        "playwright_browser_snapshot*": "allow",
        "playwright_browser_find*": "allow",
        "playwright_browser_wait_for*": "allow",
        "playwright_browser_click*": "allow"
      },
      "prompt": "{file:./prompts/browser-operator.md}"
    },
    "pdf-reader": {
      "description": "Reads and analyzes the PDF supplied for a research task. Read-only, PDF paths only, no web or command access.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra",
      "variant": "medium",
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny",
          "*.pdf": "allow"
        },
        "external_directory": "ask"
      },
      "prompt": "{file:./prompts/pdf-reader.md}"
    },
    "main": {
      "description": "General-purpose primary agent: handles simple tasks directly and coordinates research, planning, production and independent review only as needed.",
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "variant": "medium",
      "color": "#f060a6",
      "permission": {
        "task": {
          "*": "deny",
          "strategist": "allow",
          "researcher": "allow",
          "producer": "allow",
          "reviewer": "allow",
          "pdf-reader": "allow",
          "browser-operator": "allow"
        },
        "playwright_*": "deny"
      },
      "prompt": "{file:./prompts/main.md}"
    },
    "strategist": {
      "description": "Read-only, domain-independent strategy, research design, alternative evaluation and planning. Call only for meaningful uncertainty or trade-offs.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra",
      "variant": "medium",
      "color": "#5fd7c8",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "external_directory": "deny"
      },
      "prompt": "{file:./prompts/strategist.md}"
    },
    "producer": {
      "description": "General-purpose artifact producer for bounded writing, data, software, configuration or document tasks in the assigned worktree.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra",
      "variant": "low",
      "color": "#00b386",
      "permission": {
        "task": {
          "*": "deny"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "codesearch": "deny",
        "playwright_*": "deny",
        "playwright-auth_*": "deny"
      },
      "prompt": "{file:./prompts/producer.md}"
    },
    "reviewer": {
      "description": "Independent read-only review of material plans, research, writing, data and software/configuration changes.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-terra",
      "variant": "medium",
      "color": "#f2ce55",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "external_directory": "deny"
      },
      "prompt": "{file:./prompts/reviewer.md}"
    }
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12288
  },
  "plugins": [
    "-opencode.provider.openai-context-caps"
  ],
  "compaction": {
    "auto": true,
    "buffer": 20000
  },
  "experimental": {
    "subagent_depth": 1,
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "openai"
      }
    ]
  }
}
