#!/bin/sh

set -eu

marker_path="${HOME}/.local/state/opencode/agent-browser/deploy-pending"
if [ -e "$marker_path" ] || [ -L "$marker_path" ]; then
  printf '%s\n' 'Local Browser deployment is in progress.' >&2
  exit 75
fi

dotfiles_dir="${HOME}/.config/dotfiles"
opencode_dir="${HOME}/.config/opencode"

export ACCRETION_AGENT_BROWSER_MCP_ENTRYPOINT=1
exec nix develop "${dotfiles_dir}" -c \
  "${opencode_dir}/node_modules/.bin/tsx" \
  "${opencode_dir}/mcp/agent-browser-mcp.ts"
